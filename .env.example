# Public, browser-safe backend configuration (Lovable Cloud / Supabase-compatible).
# Copy to .env and fill in from the Lovable project settings. Never commit .env.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-only secret. Bypasses RLS — required for COD order creation and staff
# administration. Never expose it to the client bundle and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
