# Public, browser-safe backend configuration (Supabase-compatible managed Postgres).
# Copy to .env and fill in from the backend dashboard. Never commit .env.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Canonical public URL used by sitemap/JSON-LD (default https://proteinestore.pro)
VITE_SITE_URL=

# Optional server-only secret (RLS bypass). Only needed for privileged staff
# administration; the storefront and WhatsApp checkout work without it.
# Never prefix it with VITE_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: override the local SQLite order store (default data/proteinstore.db)
ORDER_DB_PATH=
