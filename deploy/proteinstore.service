[Unit]
Description=ProteinStore boutique (demo)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/proteinstore
ExecStart=/usr/bin/python3 /opt/proteinstore/server.py
Environment=PORT=8000
Environment=HOST=0.0.0.0
Restart=always
RestartSec=3
User=www-data

[Install]
WantedBy=multi-user.target
