[Unit]
Description=Protein Store TEST / staging (TanStack Start, Node)
Documentation=file:/root/Said/proteinstore/docs/08-staging.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/Said/proteinstore-test
EnvironmentFile=/root/Said/proteinstore-test/.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=5078
ExecStart=/usr/bin/node .output/server/index.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/Said/proteinstore-test/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target
