# ============================================================
#  CONFIGURATION LOCALE — Supabase MOCK (aucune clé cloud requise)
#  L'app parle à supabase-mock/server.py (données de démo locales).
#  Quand vous aurez vos vraies clés : remplacez les 4 valeurs
#  ci-dessous par celles du dashboard supabase.com puis relancez dev.bat
# ============================================================
SUPABASE_URL=http://127.0.0.1:8210
SUPABASE_PUBLISHABLE_KEY=sb_publishable_local-mock-000000000000
SUPABASE_PROJECT_ID=local-mock
VITE_SUPABASE_URL=http://127.0.0.1:8210
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local-mock-000000000000
VITE_SUPABASE_PROJECT_ID=local-mock

# URL canonique (sitemap/JSON-LD) — en local :
VITE_SITE_URL=http://localhost:5173

# Hôtes autorisés pour le proxy d'images /api/public/img
# (le mock local sert les photos depuis 127.0.0.1:8210)
IMPORT_ALLOWED_HOSTS=127.0.0.1,localhost
